{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-shop",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  // Migrations are bundled as text and applied automatically on startup (src/migrate.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app",
      // Replace with the id printed by: npx wrangler d1 create app
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Product images and transfer receipts. Create with: npx wrangler r2 bucket create gift-shop-images
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "gift-shop-images" }]
  // No vars or secrets: site name, bot tokens etc. are edited at /admin/settings and stored in D1.
}
